TRANSCRIPTFORGE_ENVIRONMENT=development
TRANSCRIPTFORGE_API_HOST=0.0.0.0
TRANSCRIPTFORGE_API_PORT=8000
TRANSCRIPTFORGE_DATABASE_URL=postgresql+asyncpg://transcriptforge:transcriptforge@postgres:5432/transcriptforge
TRANSCRIPTFORGE_CELERY_BROKER_URL=redis://redis:6379/0
TRANSCRIPTFORGE_CELERY_RESULT_BACKEND=redis://redis:6379/1
TRANSCRIPTFORGE_STORAGE_BACKEND=local
TRANSCRIPTFORGE_LOCAL_STORAGE_ROOT=/data/transcriptforge
TRANSCRIPTFORGE_RUN_WORK_ROOT=/data/transcriptforge/runtime
TRANSCRIPTFORGE_PIPELINE_PATH=/app/pipelines/main.nf
TRANSCRIPTFORGE_NEXTFLOW_EXECUTABLE=nextflow
TRANSCRIPTFORGE_NEXTFLOW_PROFILE=test
# AWS Batch profile (copy values from scripts/aws/render_batch_env.sh only when deploying):
# TRANSCRIPTFORGE_NEXTFLOW_PROFILE=awsbatch
# TRANSCRIPTFORGE_AWS_REGION=us-west-2
# TRANSCRIPTFORGE_AWS_BATCH_QUEUE=transcriptforge-portfolio
# TRANSCRIPTFORGE_AWS_BATCH_JOB_ROLE_ARN=arn:aws:iam::123456789012:role/transcriptforge-portfolio-job
# TRANSCRIPTFORGE_AWS_BATCH_LOG_GROUP=/aws/batch/transcriptforge-portfolio
# TRANSCRIPTFORGE_AWS_WORK_URI=s3://replace-me/work
# TRANSCRIPTFORGE_AWS_REFERENCE_CACHE_URI=s3://replace-me/references
# TRANSCRIPTFORGE_AWS_SCIENTIFIC_IMAGE=123456789012.dkr.ecr.us-west-2.amazonaws.com/repository@sha256:replace-me
TRANSCRIPTFORGE_S3_ENDPOINT_URL=http://minio:9000
TRANSCRIPTFORGE_S3_ACCESS_KEY=transcriptforge
TRANSCRIPTFORGE_S3_SECRET_KEY=transcriptforge-dev-only
TRANSCRIPTFORGE_S3_BUCKET=transcriptforge
TRANSCRIPTFORGE_S3_REGION=us-east-1
TRANSCRIPTFORGE_CORS_ORIGINS=["http://localhost:5173"]
POSTGRES_DB=transcriptforge
POSTGRES_USER=transcriptforge
POSTGRES_PASSWORD=transcriptforge
MINIO_ROOT_USER=transcriptforge
MINIO_ROOT_PASSWORD=transcriptforge-dev-only
VITE_API_BASE_URL=http://localhost:8000/api
