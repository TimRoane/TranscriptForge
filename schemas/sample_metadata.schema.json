{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.dev/schemas/sample-metadata/1.0.0",
  "title": "TranscriptForge Sample Metadata Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "path", "delimiter", "sample_id_column", "columns"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "path": { "type": "string", "minLength": 1 },
    "delimiter": { "enum": ["tab", "comma"] },
    "sample_id_column": { "const": "sample_id" },
    "columns": { "type": "array", "minItems": 1, "uniqueItems": true, "contains": { "const": "sample_id" }, "items": { "type": "string", "minLength": 1 } }
  }
}
