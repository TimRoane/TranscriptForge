{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.dev/schemas/classifier-results/1.0.0",
  "title": "TranscriptForge Binary Classifier Results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_id", "prepared_dataset_id", "method", "assay",
    "outcome", "validation", "sample_count", "input_feature_count",
    "top_variable_features", "oof_coverage", "metrics", "repeat_metrics",
    "confidence_intervals", "diagnostic_curves", "permutation_control", "learning_curve",
    "model_comparisons",
    "folds", "oof_predictions", "feature_stability", "leakage_audit", "provenance",
    "locked_model", "warnings", "software"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "prepared_dataset_id": { "type": "string", "minLength": 1 },
    "method": { "const": "elastic_net" },
    "assay": { "const": "log_expression" },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["column", "negative_class", "positive_class", "class_counts"],
      "properties": {
        "column": { "$ref": "#/$defs/variable_name" },
        "negative_class": { "type": "string", "minLength": 1 },
        "positive_class": { "type": "string", "minLength": 1 },
        "class_counts": { "$ref": "#/$defs/class_counts" }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "group_column", "cohort_column", "outer_folds", "inner_folds", "repeats", "primary_metric", "probability_calibration", "decision_threshold_strategy"],
      "properties": {
        "mode": { "const": "repeated_nested_cross_validation" },
        "group_column": { "oneOf": [{ "$ref": "#/$defs/variable_name" }, { "type": "null" }] },
        "cohort_column": { "oneOf": [{ "$ref": "#/$defs/variable_name" }, { "type": "null" }] },
        "outer_folds": { "type": "integer", "minimum": 2 },
        "inner_folds": { "type": "integer", "minimum": 2 },
        "repeats": { "type": "integer", "minimum": 1 },
        "primary_metric": { "enum": ["roc_auc", "pr_auc", "balanced_accuracy"] },
        "probability_calibration": { "enum": ["none", "sigmoid"] },
        "decision_threshold_strategy": { "enum": ["fixed_0_5", "inner_cv_youden"] }
      }
    },
    "sample_count": { "type": "integer", "minimum": 4 },
    "input_feature_count": { "type": "integer", "minimum": 1 },
    "top_variable_features": { "type": "integer", "minimum": 1 },
    "oof_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_prediction_count", "observed_prediction_count", "one_prediction_per_sample_per_repeat"],
      "properties": {
        "expected_prediction_count": { "type": "integer", "minimum": 1 },
        "observed_prediction_count": { "type": "integer", "minimum": 1 },
        "one_prediction_per_sample_per_repeat": { "const": true }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": { "type": ["number", "integer"] },
      "required": ["roc_auc", "pr_auc", "balanced_accuracy", "accuracy", "sensitivity", "specificity", "precision", "recall", "f1", "mcc", "brier_score", "true_positive", "false_positive", "true_negative", "false_negative"]
    },
    "repeat_metrics": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": { "type": ["number", "integer"] },
        "required": ["repeat", "roc_auc", "pr_auc", "balanced_accuracy", "accuracy", "sensitivity", "specificity", "precision", "recall", "f1", "mcc", "brier_score", "true_positive", "false_positive", "true_negative", "false_negative"]
      }
    },
    "confidence_intervals": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "iterations", "confidence_level", "intervals"],
      "properties": {
        "method": { "const": "experimental_unit_percentile_bootstrap" },
        "iterations": { "type": "integer", "minimum": 1 },
        "confidence_level": { "const": 0.95 },
        "intervals": {
          "type": "object", "additionalProperties": false,
          "required": ["roc_auc", "pr_auc", "balanced_accuracy", "brier_score"],
          "properties": {
            "roc_auc": { "$ref": "#/$defs/interval" },
            "pr_auc": { "$ref": "#/$defs/interval" },
            "balanced_accuracy": { "$ref": "#/$defs/interval" },
            "brier_score": { "$ref": "#/$defs/interval" }
          }
        }
      }
    },
    "diagnostic_curves": {
      "type": "object", "additionalProperties": false,
      "required": ["roc_curve", "precision_recall_curve", "calibration_curve", "calibration_intercept", "calibration_slope", "confusion_matrix"],
      "properties": {
        "roc_curve": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/roc_point" } },
        "precision_recall_curve": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/pr_point" } },
        "calibration_curve": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/calibration_point" } },
        "calibration_intercept": { "type": "number" },
        "calibration_slope": { "type": "number" },
        "confusion_matrix": { "$ref": "#/$defs/confusion" }
      }
    },
    "permutation_control": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "count", "roc_auc_values", "empirical_p_value"],
      "properties": {
        "method": { "const": "full_nested_cross_validation_label_permutation" },
        "count": { "type": "integer", "minimum": 0 },
        "roc_auc_values": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "mean_roc_auc": { "type": "number", "minimum": 0, "maximum": 1 },
        "empirical_p_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "note": { "type": "string" }
      }
    },
    "learning_curve": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["training_fraction", "mean_roc_auc", "fold_roc_auc"],
        "properties": {
          "training_fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "mean_roc_auc": { "type": "number", "minimum": 0, "maximum": 1 },
          "fold_roc_auc": { "type": "array", "minItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
        }
      }
    },
    "model_comparisons": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["method", "role", "metrics", "tuning_scope"],
        "properties": {
          "method": { "enum": ["elastic_net", "random_forest", "hist_gradient_boosting"] },
          "role": { "enum": ["primary_locked_model", "comparison_only_not_exported"] },
          "metrics": {
            "type": "object", "additionalProperties": false,
            "required": ["roc_auc", "pr_auc", "balanced_accuracy", "brier_score"],
            "properties": {
              "roc_auc": { "type": "number", "minimum": 0, "maximum": 1 },
              "pr_auc": { "type": "number", "minimum": 0, "maximum": 1 },
              "balanced_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
              "brier_score": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "tuning_scope": { "const": "inner_training_folds_only" },
          "best_parameters_by_outer_fold": {
            "type": "array", "items": { "type": "object" }
          }
        }
      }
    },
    "folds": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/fold" } },
    "oof_predictions": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/prediction" } },
    "feature_stability": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
    "leakage_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["preprocessing_scope", "feature_selection_scope", "hyperparameter_tuning_scope", "calibration_scope", "threshold_scope", "outer_test_fold_role", "all_fold_scopes_disjoint"],
      "properties": {
        "preprocessing_scope": { "const": "fit_inside_each_training_fold" },
        "feature_selection_scope": { "const": "fit_inside_each_training_fold" },
        "hyperparameter_tuning_scope": { "const": "inner_training_folds_only" },
        "calibration_scope": { "const": "inner_training_predictions_only" },
        "threshold_scope": { "const": "inner_training_predictions_only" },
        "outer_test_fold_role": { "const": "evaluation_only" },
        "all_fold_scopes_disjoint": { "const": true }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["expression_bundle_sha256", "random_seed"],
      "properties": {
        "expression_bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "random_seed": { "type": "integer", "minimum": 0 }
      }
    },
    "locked_model": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "feature_schema_path", "model_card_path", "inference_example_path"],
      "properties": {
        "path": { "const": "model.json" },
        "feature_schema_path": { "const": "inference_schema.json" },
        "model_card_path": { "const": "model_card.json" },
        "inference_example_path": { "const": "inference_example.tsv" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "software": { "type": "object" }
  },
  "$defs": {
    "variable_name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": { "lower": { "type": "number" }, "upper": { "type": "number" } }
    },
    "roc_point": {
      "type": "object", "additionalProperties": false,
      "required": ["false_positive_rate", "true_positive_rate", "threshold"],
      "properties": {
        "false_positive_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "true_positive_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "threshold": { "type": ["number", "null"] }
      }
    },
    "pr_point": {
      "type": "object", "additionalProperties": false,
      "required": ["recall", "precision", "threshold"],
      "properties": {
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "threshold": { "type": ["number", "null"] }
      }
    },
    "calibration_point": {
      "type": "object", "additionalProperties": false,
      "required": ["predicted_probability", "observed_fraction", "sample_count"],
      "properties": {
        "predicted_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "observed_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "sample_count": { "type": "integer", "minimum": 1 }
      }
    },
    "confusion": {
      "type": "object", "additionalProperties": false,
      "required": ["true_negative", "false_positive", "false_negative", "true_positive"],
      "properties": {
        "true_negative": { "type": "integer", "minimum": 0 },
        "false_positive": { "type": "integer", "minimum": 0 },
        "false_negative": { "type": "integer", "minimum": 0 },
        "true_positive": { "type": "integer", "minimum": 0 }
      }
    },
    "class_counts": { "type": "object", "minProperties": 2, "maxProperties": 2, "additionalProperties": { "type": "integer", "minimum": 1 } },
    "fold": {
      "type": "object", "additionalProperties": false,
      "required": ["repeat", "fold", "training_sample_count", "test_sample_count", "training_class_counts", "test_class_counts", "training_group_count", "test_group_count", "group_overlap_count", "selected_feature_count", "nonzero_feature_count", "best_c", "best_l1_ratio", "decision_threshold", "preprocessing_fit_sample_ids_sha256", "outer_test_sample_ids_sha256"],
      "properties": {
        "repeat": { "type": "integer", "minimum": 1 }, "fold": { "type": "integer", "minimum": 1 },
        "training_sample_count": { "type": "integer", "minimum": 2 }, "test_sample_count": { "type": "integer", "minimum": 2 },
        "training_class_counts": { "$ref": "#/$defs/class_counts" }, "test_class_counts": { "$ref": "#/$defs/class_counts" },
        "training_group_count": { "type": "integer", "minimum": 2 }, "test_group_count": { "type": "integer", "minimum": 1 },
        "group_overlap_count": { "const": 0 }, "selected_feature_count": { "type": "integer", "minimum": 1 },
        "nonzero_feature_count": { "type": "integer", "minimum": 0 }, "best_c": { "enum": [0.05, 0.5, 5.0] },
        "best_l1_ratio": { "enum": [0.0, 0.5, 1.0] }, "decision_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "preprocessing_fit_sample_ids_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "outer_test_sample_ids_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "prediction": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "repeat", "fold", "observed_class", "observed_positive", "positive_probability", "predicted_positive", "predicted_class", "group", "cohort"],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 }, "repeat": { "type": "integer", "minimum": 1 }, "fold": { "type": "integer", "minimum": 1 },
        "observed_class": { "type": "string", "minLength": 1 }, "observed_positive": { "type": "boolean" },
        "positive_probability": { "type": "number", "minimum": 0, "maximum": 1 }, "predicted_positive": { "type": "boolean" },
        "predicted_class": { "type": "string", "minLength": 1 }, "group": { "type": ["string", "null"] }, "cohort": { "type": ["string", "null"] }
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["feature_id", "selection_frequency", "nonzero_frequency", "mean_coefficient"],
      "properties": {
        "feature_id": { "type": "string", "minLength": 1 }, "selection_frequency": { "type": "number", "minimum": 0, "maximum": 1 },
        "nonzero_frequency": { "type": "number", "minimum": 0, "maximum": 1 }, "mean_coefficient": { "type": "number" }
      }
    }
  }
}
