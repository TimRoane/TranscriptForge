{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.local/schemas/signature_scores.schema.json",
  "title": "TranscriptForge Signature Scores",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "prepared_dataset_id",
    "method",
    "assay",
    "formula",
    "signature_mapping",
    "sample_count",
    "set_count",
    "sets",
    "phenotype_association",
    "warnings",
    "software"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "analysis_id": { "$ref": "#/$defs/nonempty" },
    "prepared_dataset_id": { "$ref": "#/$defs/nonempty" },
    "method": {
      "enum": ["mean_expression", "mean_z_score", "weighted_linear", "rank_based", "gsva", "ssgsea"]
    },
    "assay": { "const": "log_expression" },
    "formula": { "$ref": "#/$defs/nonempty" },
    "signature_mapping": { "$ref": "#/$defs/mapping" },
    "sample_count": { "type": "integer", "minimum": 1 },
    "set_count": { "type": "integer", "minimum": 1 },
    "sets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/set" } },
    "phenotype_association": {
      "oneOf": [{ "$ref": "#/$defs/phenotype_association" }, { "type": "null" }]
    },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
    "software": { "$ref": "#/$defs/software" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "language_version", "implementation", "packages"],
      "properties": {
        "language": { "$ref": "#/$defs/nonempty" },
        "language_version": { "$ref": "#/$defs/nonempty" },
        "implementation": { "$ref": "#/$defs/nonempty" },
        "packages": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonempty" }
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "report_sha256",
        "signature_definition_id",
        "signature_definition_sha256",
        "expression_bundle_sha256",
        "mapping_coverage",
        "requested_identifier_count",
        "mapped_identifier_count",
        "missing_identifier_count",
        "ambiguous_identifier_count",
        "duplicate_identifier_count"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "report_sha256": { "$ref": "#/$defs/sha256" },
        "signature_definition_id": { "$ref": "#/$defs/nonempty" },
        "signature_definition_sha256": { "$ref": "#/$defs/sha256" },
        "expression_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "mapping_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "requested_identifier_count": { "type": "integer", "minimum": 1 },
        "mapped_identifier_count": { "type": "integer", "minimum": 1 },
        "missing_identifier_count": { "type": "integer", "minimum": 0 },
        "ambiguous_identifier_count": { "type": "integer", "minimum": 0 },
        "duplicate_identifier_count": { "type": "integer", "minimum": 0 }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "score", "metadata"],
      "properties": {
        "sample_id": { "$ref": "#/$defs/nonempty" },
        "score": { "type": "number" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_id",
        "name",
        "requested_identifier_count",
        "mapped_identifier_count",
        "scored_feature_count",
        "excluded_constant_feature_count",
        "mapping_coverage",
        "score_minimum",
        "score_maximum",
        "score_mean",
        "scores"
      ],
      "properties": {
        "signature_id": { "$ref": "#/$defs/nonempty" },
        "name": { "$ref": "#/$defs/nonempty" },
        "requested_identifier_count": { "type": "integer", "minimum": 1 },
        "mapped_identifier_count": { "type": "integer", "minimum": 1 },
        "scored_feature_count": { "type": "integer", "minimum": 1 },
        "excluded_constant_feature_count": { "type": "integer", "minimum": 0 },
        "mapping_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "score_minimum": { "type": "number" },
        "score_maximum": { "type": "number" },
        "score_mean": { "type": "number" },
        "scores": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/score" } }
      }
    },
    "group_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "sample_count", "score_mean"],
      "properties": {
        "level": { "$ref": "#/$defs/nonempty" },
        "sample_count": { "type": "integer", "minimum": 1 },
        "score_mean": { "type": "number" }
      }
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_id", "signature_name", "test", "sample_count", "effect", "statistic", "degrees_of_freedom", "p_value", "adjusted_p_value", "correlation", "group_summaries"],
      "properties": {
        "signature_id": { "$ref": "#/$defs/nonempty" },
        "signature_name": { "$ref": "#/$defs/nonempty" },
        "test": { "enum": ["adjusted_linear_regression", "adjusted_two_group_comparison", "adjusted_omnibus_group_comparison"] },
        "sample_count": { "type": "integer", "minimum": 3 },
        "effect": { "type": ["number", "null"] },
        "statistic": { "type": "number" },
        "degrees_of_freedom": { "type": "integer", "minimum": 1 },
        "p_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "adjusted_p_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "correlation": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "group_summaries": { "type": "array", "items": { "$ref": "#/$defs/group_summary" } }
      }
    },
    "phenotype_association": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phenotype_column", "phenotype_kind", "covariates", "block_column", "formula", "design_matrix_columns", "associations"],
      "properties": {
        "phenotype_column": { "$ref": "#/$defs/nonempty" },
        "phenotype_kind": { "enum": ["categorical", "numeric"] },
        "covariates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
        "block_column": { "type": ["string", "null"] },
        "formula": { "$ref": "#/$defs/nonempty" },
        "design_matrix_columns": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/nonempty" } },
        "associations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/association" } }
      }
    }
  }
}
