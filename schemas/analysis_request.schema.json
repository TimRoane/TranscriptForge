{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.dev/schemas/analysis-request/1.0.0",
  "title": "TranscriptForge Frozen Analysis Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "prepared_dataset_id", "analysis_type", "method", "assay", "parameters", "random_seed"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "run_type": { "const": "analysis" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "prepared_dataset_id": { "type": "string", "minLength": 1 },
    "analysis_type": { "enum": ["differential_expression", "dimension_reduction", "classifier", "signature", "deconvolution"] },
    "method": { "type": "string", "minLength": 1 },
    "assay": { "type": "string", "minLength": 1 },
    "included_samples": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "excluded_samples": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "parameters": { "type": "object" },
    "random_seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "design_formula": { "type": "string", "minLength": 3 },
    "contrast_label": { "type": "string", "minLength": 1 },
    "design_validation": { "type": "object" },
    "signature_mapping": { "type": "object" },
    "method_registry_version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$" },
    "method_registry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "deconvolution_method": { "type": "object" },
    "input_assay_descriptor": { "type": "object" },
    "expression_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_uri", "sha256", "size_bytes"],
      "properties": {
        "storage_uri": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "analysis_type": { "const": "dimension_reduction" } }, "required": ["analysis_type"] },
      "then": {
        "properties": {
          "method": { "enum": ["pca", "hierarchical_clustering", "umap", "tsne"] },
          "parameters": { "$ref": "#/$defs/dimension_parameters" }
        }
      }
    },
    {
      "if": { "properties": { "analysis_type": { "const": "differential_expression" } }, "required": ["analysis_type"] },
      "then": {
        "required": ["design_formula", "contrast_label", "design_validation"],
        "properties": {
          "method": { "enum": ["deseq2", "limma", "edger_ql", "limma_voom"] },
          "parameters": { "$ref": "#/$defs/differential_expression_parameters" }
        }
      }
    },
    {
      "if": { "properties": { "analysis_type": { "const": "signature" } }, "required": ["analysis_type"] },
      "then": {
        "required": ["signature_mapping"],
        "properties": {
          "method": { "enum": ["mean_expression", "mean_z_score", "weighted_linear", "rank_based", "gsva", "ssgsea"] },
          "assay": { "const": "log_expression" },
          "parameters": { "$ref": "#/$defs/signature_parameters" },
          "signature_mapping": { "$ref": "#/$defs/signature_mapping" }
        }
      }
    },
    {
      "if": { "properties": { "analysis_type": { "const": "deconvolution" } }, "required": ["analysis_type"] },
      "then": {
        "required": ["method_registry_version", "method_registry_sha256", "deconvolution_method", "input_assay_descriptor"],
        "properties": {
          "method": { "enum": ["epic", "quantiseq", "mcp_counter", "xcell"] },
          "parameters": { "$ref": "#/$defs/deconvolution_parameters" },
          "deconvolution_method": { "$ref": "#/$defs/deconvolution_method" },
          "input_assay_descriptor": { "$ref": "#/$defs/deconvolution_assay" }
        },
        "allOf": [
          {
            "if": { "properties": { "method": { "enum": ["epic", "quantiseq"] } }, "required": ["method"] },
            "then": { "properties": { "assay": { "const": "tpm" } } }
          },
          {
            "if": { "properties": { "method": { "enum": ["mcp_counter", "xcell"] } }, "required": ["method"] },
            "then": { "properties": { "assay": { "const": "log_expression" } } }
          }
        ]
      }
    }
  ],
  "$defs": {
    "deconvolution_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_profile", "minimum_gene_overlap", "tumor_mode", "scale_mrna"],
      "properties": {
        "reference_profile": { "type": "string", "minLength": 1, "maxLength": 100 },
        "minimum_gene_overlap": { "type": "number", "minimum": 0, "maximum": 1 },
        "tumor_mode": { "type": "boolean" },
        "scale_mrna": { "type": "boolean" }
      }
    },
    "deconvolution_assay": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "scale", "value_type", "feature_level", "sha256"],
      "properties": {
        "name": { "enum": ["tpm", "log_expression"] },
        "scale": { "enum": ["linear", "log2", "variance_stabilized"] },
        "value_type": { "enum": ["nonnegative_continuous", "continuous"] },
        "feature_level": { "const": "gene" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "deconvolution_method": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "display_name", "execution_mode", "implementation_status", "result_type", "quantity_label", "unit", "composition_constraint", "input", "references", "default_reference", "interpretation"],
      "properties": {
        "id": { "enum": ["epic", "quantiseq", "mcp_counter", "xcell"] },
        "display_name": { "type": "string", "minLength": 1 },
        "execution_mode": { "const": "native" },
        "implementation_status": { "enum": ["runner_pending", "planned", "license_blocked", "available"] },
        "result_type": { "enum": ["cell_fraction", "enrichment_score"] },
        "quantity_label": { "type": "string", "minLength": 1 },
        "unit": { "enum": ["fraction", "arbitrary_score"] },
        "composition_constraint": { "enum": ["bounded_sum", "sum_to_one_with_other", "not_compositional"] },
        "input": { "type": "object" },
        "references": { "type": "array" },
        "default_reference": { "type": "string", "minLength": 1 },
        "interpretation": { "type": "string", "minLength": 1 }
      }
    },
    "signature_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_mapping_id",
        "minimum_gene_set_size",
        "maximum_gene_set_size",
        "gsva_kcdf",
        "gsva_tau",
        "gsva_max_diff",
        "gsva_abs_ranking",
        "ssgsea_alpha",
        "ssgsea_normalize"
      ],
      "properties": {
        "signature_mapping_id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "minimum_gene_set_size": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maximum_gene_set_size": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "gsva_kcdf": { "enum": ["auto", "Gaussian", "Poisson", "none"] },
        "gsva_tau": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "gsva_max_diff": { "type": "boolean" },
        "gsva_abs_ranking": { "type": "boolean" },
        "ssgsea_alpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "ssgsea_normalize": { "type": "boolean" },
        "phenotype_association": { "$ref": "#/$defs/phenotype_association" }
      }
    },
    "phenotype_association": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "phenotype_column", "phenotype_kind", "covariates", "block_column"],
      "properties": {
        "enabled": { "type": "boolean" },
        "phenotype_column": { "oneOf": [{ "$ref": "#/$defs/variable_name" }, { "type": "null" }] },
        "phenotype_kind": { "enum": ["auto", "categorical", "numeric"] },
        "covariates": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "$ref": "#/$defs/variable_name" } },
        "block_column": { "oneOf": [{ "$ref": "#/$defs/variable_name" }, { "type": "null" }] }
      }
    },
    "signature_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "report_sha256", "report"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "report": { "type": "object" }
      }
    },
    "dimension_parameters": {
      "type": "object",
      "properties": {
        "component_count": { "type": "integer", "minimum": 2, "maximum": 20 },
        "scale_features": { "type": "boolean" },
        "top_variable_features": { "type": "integer", "minimum": 10 },
        "distance_metric": { "enum": ["euclidean", "correlation"] },
        "linkage_method": { "enum": ["average", "complete", "ward"] },
        "cluster_count": { "type": "integer", "minimum": 2 },
        "neighbors": { "type": "integer", "minimum": 2 },
        "min_distance": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "perplexity": { "type": "number", "minimum": 2 }
      }
    },
    "differential_expression_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "contrast", "low_count_threshold", "minimum_samples", "fdr_threshold", "absolute_log2_fold_change", "independent_filtering", "shrinkage"],
      "properties": {
        "design": { "$ref": "#/$defs/design" },
        "contrast": { "$ref": "#/$defs/contrast" },
        "low_count_threshold": { "type": "integer", "minimum": 0 },
        "minimum_samples": { "type": "integer", "minimum": 1 },
        "fdr_threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "absolute_log2_fold_change": { "type": "number", "minimum": 0 },
        "independent_filtering": { "type": "boolean" },
        "shrinkage": { "type": "boolean" },
        "enrichment": { "$ref": "#/$defs/enrichment" }
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "collection_id", "ranking_metric", "permutation_count", "minimum_gene_set_size", "maximum_gene_set_size"],
      "properties": {
        "enabled": { "type": "boolean" },
        "collection_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 100 },
        "ranking_metric": { "const": "signed_log10_p_value" },
        "permutation_count": { "type": "integer", "minimum": 100, "maximum": 5000 },
        "minimum_gene_set_size": { "type": "integer", "minimum": 2, "maximum": 5000 },
        "maximum_gene_set_size": { "type": "integer", "minimum": 2, "maximum": 10000 }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_variable", "covariates", "block_column", "interaction_terms", "reference_levels"],
      "properties": {
        "primary_variable": { "$ref": "#/$defs/variable_name" },
        "covariates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/variable_name" } },
        "block_column": { "oneOf": [{ "$ref": "#/$defs/variable_name" }, { "type": "null" }] },
        "interaction_terms": {
          "type": "array",
          "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/variable_name" } }
        },
        "reference_levels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "numerator", "denominator"],
      "properties": {
        "variable": { "$ref": "#/$defs/variable_name" },
        "numerator": { "type": "string", "minLength": 1 },
        "denominator": { "type": "string", "minLength": 1 }
      }
    },
    "variable_name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
  }
}
