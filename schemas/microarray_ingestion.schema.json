{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.dev/schemas/microarray-ingestion/1.0.0",
  "title": "TranscriptForge raw Affymetrix ingestion manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_id", "organism", "source_kind", "platform",
    "aggregation_method", "sample_metadata", "sample_count", "cel_file_count",
    "samples", "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "organism": { "const": "Homo sapiens" },
    "source_kind": { "const": "affymetrix_cel" },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": [
        "platform_id", "definition_sha256", "adapter_version", "vendor", "array_design",
        "detected_chip_type", "cel_format", "normalization", "annotation"
      ],
      "properties": {
        "platform_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
        "definition_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "adapter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "vendor": { "const": "Affymetrix" },
        "array_design": { "type": "string", "minLength": 1 },
        "detected_chip_type": { "type": "string", "minLength": 1 },
        "cel_format": { "enum": ["calvin", "xda"] },
        "normalization": { "type": "object" },
        "annotation": { "type": "object" }
      }
    },
    "aggregation_method": { "enum": ["highest_mad", "median", "mean"] },
    "sample_metadata": { "$ref": "#/$defs/file" },
    "sample_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "cel_file_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "samples": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sample_id", "cel_file", "metadata"],
        "properties": {
          "sample_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
          "cel_file": { "$ref": "#/$defs/file" },
          "metadata": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_file_id", "role", "original_name", "storage_uri", "size_bytes", "sha256"],
      "properties": {
        "dataset_file_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["cel_file", "sample_metadata"] },
        "original_name": { "type": "string", "minLength": 1 },
        "storage_uri": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
