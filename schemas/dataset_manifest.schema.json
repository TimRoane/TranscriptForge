{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.dev/schemas/dataset-manifest/1.0.0",
  "title": "TranscriptForge Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_id", "name", "organism", "modality", "source_kind",
    "genome_build", "annotation_release", "feature_id_type", "created_by", "checksums"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "dataset_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "organism": { "const": "Homo sapiens" },
    "modality": { "enum": ["bulk_rnaseq", "microarray", "generic_expression"] },
    "source_kind": { "enum": ["fastq", "count_matrix", "salmon_quant", "affymetrix_cel", "normalized_matrix"] },
    "genome_build": { "const": "GRCh38" },
    "annotation_release": { "type": "string", "minLength": 1 },
    "feature_id_type": { "enum": ["ensembl_gene_id", "gene_symbol", "entrez_id", "probe_id", "transcript_id"] },
    "value_type": { "enum": ["raw_counts", "normalized_expression", "transcript_abundance", "intensity"] },
    "matrix_orientation": { "enum": ["features_by_samples", "samples_by_features"] },
    "matrix_file": { "type": "string", "minLength": 1 },
    "sample_metadata_file": { "type": "string", "minLength": 1 },
    "sample_sheet_file": { "type": "string", "minLength": 1 },
    "input_files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "sample_id_column": { "type": "string", "minLength": 1 },
    "feature_id_column": { "type": "string", "minLength": 1 },
    "paired_end": { "type": ["boolean", "null"] },
    "strandedness": { "enum": ["unstranded", "forward", "reverse", "auto", null] },
    "created_by": { "const": "transcriptforge" },
    "checksums": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  },
  "allOf": [
    {
      "oneOf": [
        { "properties": { "modality": { "const": "bulk_rnaseq" }, "source_kind": { "enum": ["fastq", "count_matrix", "salmon_quant"] } } },
        { "properties": { "modality": { "const": "microarray" }, "source_kind": { "enum": ["affymetrix_cel", "normalized_matrix"] } } },
        { "properties": { "modality": { "const": "generic_expression" }, "source_kind": { "const": "normalized_matrix" } } }
      ]
    },
    {
      "if": { "properties": { "source_kind": { "enum": ["count_matrix", "normalized_matrix"] } }, "required": ["source_kind"] },
      "then": { "required": ["matrix_file", "sample_metadata_file", "matrix_orientation", "sample_id_column", "feature_id_column", "value_type"] }
    },
    {
      "if": { "properties": { "source_kind": { "enum": ["fastq", "salmon_quant"] } }, "required": ["source_kind"] },
      "then": { "required": ["sample_sheet_file"] }
    },
    {
      "if": { "properties": { "source_kind": { "const": "affymetrix_cel" } }, "required": ["source_kind"] },
      "then": { "required": ["input_files", "sample_metadata_file"] }
    }
  ]
}
