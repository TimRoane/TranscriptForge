{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.dev/schemas/raw-rnaseq-ingestion/1.1.0",
  "title": "TranscriptForge Raw RNA-seq Ingestion Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_id", "organism", "genome_build", "source_kind",
    "reference", "sample_sheet", "library_layout", "strandedness", "sample_count",
    "lane_count", "read_file_count", "samples", "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "organism": { "const": "Homo sapiens" },
    "genome_build": { "type": "string", "pattern": "^GRCh38" },
    "source_kind": { "const": "fastq" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "definition_sha256", "name", "annotation_release", "salmon_version"],
      "properties": {
        "reference_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "definition_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "name": { "type": "string", "minLength": 1 },
        "annotation_release": { "type": "string", "minLength": 1 },
        "salmon_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "sample_sheet": { "$ref": "#/$defs/file" },
    "library_layout": { "enum": ["single_end", "paired_end"] },
    "strandedness": { "enum": ["auto", "unstranded", "forward", "reverse"] },
    "sample_count": { "type": "integer", "minimum": 1 },
    "lane_count": { "type": "integer", "minimum": 1 },
    "read_file_count": { "type": "integer", "minimum": 1 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "lanes", "metadata"],
        "properties": {
          "sample_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
          "lanes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lane_id", "read1", "read2"],
              "properties": {
                "lane_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" },
                "read1": { "$ref": "#/$defs/file" },
                "read2": { "oneOf": [{ "$ref": "#/$defs/file" }, { "type": "null" }] }
              }
            }
          },
          "metadata": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_file_id", "role", "original_name", "storage_uri", "size_bytes", "sha256"],
      "properties": {
        "dataset_file_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["sample_sheet", "fastq_r1", "fastq_r2"] },
        "original_name": { "type": "string", "minLength": 1 },
        "storage_uri": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
