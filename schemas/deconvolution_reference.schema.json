{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.local/schemas/deconvolution_reference.schema.json",
  "title": "TranscriptForge Pinned Deconvolution Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "method", "version", "organism", "identifier_namespace", "package", "files", "signature_gene_count", "cell_types"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "method": {"const": "quantiseq"},
    "version": {"type": "string", "minLength": 1},
    "organism": {"const": "Homo sapiens"},
    "identifier_namespace": {"const": "gene_symbol"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "bioconductor_release", "source_url", "source_sha256", "license"],
      "properties": {
        "name": {"const": "quantiseqr"},
        "version": {"type": "string", "minLength": 1},
        "bioconductor_release": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "license": {"const": "GPL-3"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_path", "sha256"],
        "properties": {
          "package_path": {"type": "string", "pattern": "^extdata/[A-Za-z0-9_.-]+$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "signature_gene_count": {"type": "integer", "minimum": 1},
    "cell_types": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
