{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.dev/schemas/classifier-external-validation-results/1.0.0",
  "title": "TranscriptForge Classifier External Validation Results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_id", "status", "model_analysis_id", "sample_count",
    "class_counts", "metrics", "confidence_intervals", "success", "provenance", "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "protocol_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["SUCCESS_CRITERIA_MET", "SUCCESS_CRITERIA_NOT_MET"] },
    "model_analysis_id": { "type": "string", "minLength": 1 },
    "sample_count": { "type": "integer", "minimum": 1 },
    "class_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["negative", "positive"],
      "properties": {
        "negative": { "type": "integer", "minimum": 1 },
        "positive": { "type": "integer", "minimum": 1 }
      }
    },
    "metrics": { "$ref": "#/$defs/metrics" },
    "confidence_intervals": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "iterations", "random_seed", "metrics"],
      "properties": {
        "method": { "const": "stratified_experimental_unit_percentile_bootstrap" },
        "iterations": { "type": "integer", "minimum": 1000 },
        "random_seed": { "type": "integer", "minimum": 0 },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roc_auc", "pr_auc", "balanced_accuracy", "sensitivity", "specificity", "brier_score"],
          "properties": {
            "roc_auc": { "$ref": "#/$defs/interval" },
            "pr_auc": { "$ref": "#/$defs/interval" },
            "balanced_accuracy": { "$ref": "#/$defs/interval" },
            "sensitivity": { "$ref": "#/$defs/interval" },
            "specificity": { "$ref": "#/$defs/interval" },
            "brier_score": { "$ref": "#/$defs/interval" }
          }
        }
      }
    },
    "success": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_metric", "minimum_point_estimate", "minimum_lower_confidence_bound", "point_estimate_passed", "lower_bound_passed", "passed"],
      "properties": {
        "primary_metric": { "const": "roc_auc" },
        "minimum_point_estimate": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "minimum_lower_confidence_bound": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "point_estimate_passed": { "type": "boolean" },
        "lower_bound_passed": { "type": "boolean" },
        "passed": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_sha256", "prediction_results_sha256", "truth_sha256", "model_sha256", "expression_bundle_sha256"],
      "properties": {
        "protocol_sha256": { "$ref": "#/$defs/sha256" },
        "prediction_results_sha256": { "$ref": "#/$defs/sha256" },
        "truth_sha256": { "$ref": "#/$defs/sha256" },
        "model_sha256": { "$ref": "#/$defs/sha256" },
        "expression_bundle_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "warnings": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "number" },
        "upper": { "type": "number" }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["roc_auc", "pr_auc", "prevalence", "balanced_accuracy", "sensitivity", "specificity", "brier_score", "calibration_intercept", "calibration_slope"],
      "properties": {
        "roc_auc": { "type": "number", "minimum": 0, "maximum": 1 },
        "pr_auc": { "type": "number", "minimum": 0, "maximum": 1 },
        "prevalence": { "type": "number", "minimum": 0, "maximum": 1 },
        "balanced_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "sensitivity": { "type": "number", "minimum": 0, "maximum": 1 },
        "specificity": { "type": "number", "minimum": 0, "maximum": 1 },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "calibration_intercept": { "type": "number" },
        "calibration_slope": { "type": "number" }
      }
    }
  }
}
