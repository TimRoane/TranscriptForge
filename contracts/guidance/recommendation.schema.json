{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.local/contracts/recommendation/1.0.0",
  "title": "Controlled scientific recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "assay_project_id", "source_type", "source_id", "rule_id", "recommendation_type", "title", "summary", "why", "what_it_resolves", "stage", "priority", "requirement_level", "status", "required_inputs", "expected_output", "proposed_action", "evidence_refs", "assumptions", "limitations", "alternative_action_ids", "scientist_decision_required", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "assay_project_id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["READINESS", "QUESTION", "EXPERIMENT", "ANALYSIS", "MODEL", "STUDY"]},
    "source_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "recommendation_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "why": {"type": "string", "minLength": 1},
    "what_it_resolves": {"type": "string", "minLength": 1},
    "stage": {"enum": ["DEFINE", "FEASIBILITY", "EXPLORE", "OPTIMIZE", "DEVELOP", "LOCK", "VALIDATE", "REPORT"]},
    "priority": {"type": "integer", "minimum": 0},
    "requirement_level": {"enum": ["BLOCKER", "STRONGLY_RECOMMENDED", "RECOMMENDED", "OPTIONAL", "NOT_RECOMMENDED"]},
    "status": {"enum": ["OPEN", "ACCEPTED", "REJECTED", "MODIFIED", "SUPERSEDED", "COMPLETED"]},
    "required_inputs": {"type": "array", "items": {"type": "string"}},
    "expected_output": {"type": "string", "minLength": 1},
    "proposed_action": {"type": "object"},
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "alternative_action_ids": {"type": "array", "items": {"type": "string"}},
    "scientist_decision_required": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
