{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.local/contracts/model-manifest/1.0.0",
  "title": "Immutable locked model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "status", "ordered_feature_schema", "missing_feature_behavior", "imputation_rules", "transformations", "scaling_parameters", "normalization_assumptions", "serialized_model", "outcome_classes", "probability_interpretation", "decision_rule", "expected_assay", "training_dataset_refs", "validation_dataset_refs", "software_versions", "container_digest", "model_card", "inference_fixture", "checksums"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "model_id": {"type": "string", "minLength": 1},
    "status": {"const": "LOCKED"},
    "ordered_feature_schema": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "missing_feature_behavior": {"enum": ["ERROR", "IMPUTE_DECLARED"]},
    "imputation_rules": {"type": "object"},
    "transformations": {"type": "array", "items": {"type": "object"}},
    "scaling_parameters": {"type": "object"},
    "normalization_assumptions": {"type": "array", "items": {"type": "string"}},
    "serialized_model": {"type": "object", "required": ["uri", "sha256"], "properties": {"uri": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "outcome_classes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "probability_interpretation": {"type": "string", "minLength": 1},
    "decision_rule": {"type": "object", "minProperties": 1},
    "expected_assay": {"type": "string", "minLength": 1},
    "training_dataset_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "validation_dataset_refs": {"type": "array", "items": {"type": "object"}},
    "software_versions": {"type": "object", "minProperties": 1},
    "container_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "model_card": {"type": "object", "minProperties": 1},
    "inference_fixture": {"type": "object", "required": ["input_uri", "expected_output_uri", "status"], "properties": {"input_uri": {"type": "string"}, "expected_output_uri": {"type": "string"}, "status": {"const": "PASS"}}},
    "checksums": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
