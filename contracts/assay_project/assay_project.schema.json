{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.local/contracts/assay-project/1.0.0",
  "title": "Assay Development Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "name", "proposed_purpose", "specimen_type", "biological_context", "proposed_output", "current_stage", "readiness_status", "created_by", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "proposed_purpose": {"type": "string", "minLength": 1, "maxLength": 10000},
    "specimen_type": {"type": "string", "minLength": 1, "maxLength": 200},
    "biological_context": {"type": "string", "minLength": 1, "maxLength": 10000},
    "proposed_output": {"type": "string", "minLength": 1, "maxLength": 500},
    "current_stage": {"enum": ["DEFINE", "FEASIBILITY", "EXPLORE", "OPTIMIZE", "DEVELOP", "LOCK", "VALIDATE", "REPORT", "ON_HOLD", "COMPLETED"]},
    "readiness_status": {"enum": ["NOT_ASSESSED", "BLOCKED", "NEEDS_INFORMATION", "READY_FOR_RECOMMENDED_ACTION", "ACTION_IN_PROGRESS", "REVIEW_REQUIRED"]},
    "active_question_id": {"type": ["string", "null"]},
    "assay_version": {"type": ["string", "null"]},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
