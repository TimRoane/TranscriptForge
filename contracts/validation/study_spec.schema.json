{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.local/contracts/study-spec/1.0.0",
  "title": "Immutable post-lock analytical StudySpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study", "assay_context", "model", "inputs", "sample_structure", "factors", "endpoints", "analysis_plan", "acceptance_criteria", "design_validation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "study": {"type": "object", "additionalProperties": false, "required": ["study_id", "name", "type", "objective", "revision"], "properties": {"study_id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "type": {"enum": ["PRECISION_REPRODUCIBILITY", "INPUT_DEGRADATION_LIMIT", "PAIRED_BRIDGING", "ROBUSTNESS_INTERFERENCE"]}, "objective": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}}},
    "assay_context": {"type": "object", "required": ["assay_name", "assay_version", "specimen_type", "intended_use_statement"], "properties": {"assay_name": {"type": "string"}, "assay_version": {"type": "string"}, "specimen_type": {"type": "string"}, "intended_use_statement": {"type": "string"}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["model_id", "required_status", "manifest_sha256"], "properties": {"model_id": {"type": "string"}, "required_status": {"const": "LOCKED"}, "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "inputs": {"type": "object", "required": ["assignment_table", "expression_bundles"], "properties": {"assignment_table": {"type": "string"}, "expression_bundles": {"type": "array", "minItems": 1, "items": {"type": "object"}}}},
    "sample_structure": {"type": "object", "required": ["measurement_id", "biological_sample_id", "replicate_id"], "properties": {"measurement_id": {"type": "string"}, "biological_sample_id": {"type": "string"}, "replicate_id": {"type": "string"}}},
    "factors": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "type", "treatment"], "properties": {"name": {"type": "string"}, "type": {"enum": ["categorical", "continuous", "ordered_numeric"]}, "treatment": {"enum": ["fixed", "random"]}}}},
    "endpoints": {"type": "object", "required": ["continuous", "categorical", "qc"], "properties": {"continuous": {"type": "array", "items": {"type": "string"}}, "categorical": {"type": "array", "items": {"type": "string"}}, "qc": {"type": "array", "items": {"type": "string"}}}},
    "analysis_plan": {"type": "object", "required": ["template", "confidence_level"], "properties": {"template": {"type": "string"}, "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "bootstrap_iterations": {"type": "integer", "minimum": 1}, "threshold_proximity_band": {"type": "number", "minimum": 0}}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["key", "metric", "endpoint", "operator", "threshold", "rationale"], "properties": {"key": {"type": "string"}, "metric": {"type": "string"}, "endpoint": {"type": "string"}, "operator": {"enum": ["gt", "gte", "lt", "lte", "between", "absolute_lte", "all_levels", "consecutive_levels", "categorical_equals"]}, "threshold": {}, "rationale": {"type": "string", "minLength": 1}}}},
    "design_validation": {"type": "object", "required": ["valid", "errors", "warnings"], "properties": {"valid": {"type": "boolean"}, "errors": {"type": "array", "items": {"type": "object"}}, "warnings": {"type": "array", "items": {"type": "object"}}}}
  }
}
