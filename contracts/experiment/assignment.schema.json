{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptforge.local/contracts/experiment-assignment/1.0.0",
  "title": "Development Experiment assignment row",
  "type": "object",
  "additionalProperties": false,
  "required": ["measurement_id", "biological_sample_id", "prepared_dataset_id", "include"],
  "properties": {
    "measurement_id": {"type": "string", "minLength": 1},
    "biological_sample_id": {"type": "string", "minLength": 1},
    "prepared_dataset_id": {"type": "string", "minLength": 1},
    "include": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"]},
    "replicate_id": {"type": ["string", "null"]},
    "pair_id": {"type": ["string", "null"]},
    "condition": {"type": ["string", "null"]},
    "quality_metric": {"type": ["number", "null"]},
    "reference_condition": {"type": ["string", "null"]},
    "challenge_condition": {"type": ["string", "null"]},
    "input_level": {"type": ["number", "null"]},
    "operator": {"type": ["string", "null"]},
    "reagent_lot": {"type": ["string", "null"]},
    "instrument": {"type": ["string", "null"]},
    "site": {"type": ["string", "null"]},
    "run": {"type": ["string", "null"]},
    "sequencing_run": {"type": ["string", "null"]},
    "input_ng": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "dv200": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "day": {"type": ["string", "null"]},
    "plate": {"type": ["string", "null"]},
    "well": {"type": ["string", "null"]},
    "processing_order": {"type": ["integer", "null"], "minimum": 1}
  },
  "allOf": [{"if": {"properties": {"include": {"const": false}}}, "then": {"required": ["exclusion_reason"], "properties": {"exclusion_reason": {"type": "string", "minLength": 1}}}}]
}
