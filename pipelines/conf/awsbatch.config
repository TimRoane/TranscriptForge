// AWS Batch production profile. Secrets and static access keys are deliberately
// excluded: Nextflow and Batch obtain short-lived credentials from their IAM roles.
def tfAwsRegion = System.getenv('TRANSCRIPTFORGE_AWS_REGION') ?: params.aws_region
def tfAwsQueue = System.getenv('TRANSCRIPTFORGE_AWS_BATCH_QUEUE') ?: params.aws_batch_queue
def tfAwsJobRole = System.getenv('TRANSCRIPTFORGE_AWS_BATCH_JOB_ROLE_ARN') ?: params.aws_batch_job_role_arn
def tfAwsImage = System.getenv('TRANSCRIPTFORGE_AWS_SCIENTIFIC_IMAGE') ?: params.aws_scientific_image
def tfAwsLogGroup = System.getenv('TRANSCRIPTFORGE_AWS_BATCH_LOG_GROUP') ?: params.aws_batch_log_group
def tfAwsReferenceCacheUri = System.getenv('TRANSCRIPTFORGE_AWS_REFERENCE_CACHE_URI') ?: params.aws_reference_cache_uri

process {
    executor = 'awsbatch'
    queue = tfAwsQueue
    container = tfAwsImage
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries = 2

    // Module-local images are useful for portable development. Production uses
    // one digest-pinned image so local/Batch scientific toolchains cannot diverge.
    withName: PHASE0_SMOKE { container = tfAwsImage }
    withName: VALIDATE_COUNT_MATRIX { container = tfAwsImage }
    withName: BUILD_EXPRESSION_BUNDLE { container = tfAwsImage }
    withName: RUN_DIMENSION_REDUCTION { container = tfAwsImage }
    withName: RUN_DIFFERENTIAL_EXPRESSION { container = tfAwsImage }
    withName: RUN_SIGNATURE_SCORING { container = tfAwsImage }
    withName: RUN_GSVA_SCORING { container = tfAwsImage }
    withName: RUN_DECONVOLUTION { container = tfAwsImage }
    withName: RUN_CLASSIFIER { container = tfAwsImage }
    withName: VERIFY_RAW_INPUTS { container = tfAwsImage }
    withName: MATERIALIZE_SALMON_REFERENCE { container = tfAwsImage }
    withName: FASTQC_READS { container = tfAwsImage }
    withName: FASTP_TRIM { container = tfAwsImage }
    withName: SALMON_QUANT { container = tfAwsImage }
    withName: TXIMPORT_GENE_SUMMARIES { container = tfAwsImage }
    withName: MULTIQC_RAW_RNASEQ { container = tfAwsImage }
    withName: BUILD_RAW_EXPRESSION_BUNDLE { container = tfAwsImage }
}

params.reference_cache = '.transcriptforge-reference-cache'
params.reference_cache_uri = tfAwsReferenceCacheUri

aws {
    region = tfAwsRegion
    batch {
        jobRole = tfAwsJobRole
        logsGroup = tfAwsLogGroup
        maxSpotAttempts = 2
        maxTransferAttempts = 3
        retryMode = 'standard'
        terminateUnschedulableJobs = true
    }
}

executor {
    queueSize = 100
    pollInterval = '10 sec'
    submitRateLimit = '20/1 sec'
}

docker.enabled = false
