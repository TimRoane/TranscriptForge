process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    env.LANG = 'en_US.UTF-8'
    env.LC_ALL = 'en_US.UTF-8'

    withLabel: process_low {
        cpus = 1
        memory = 1.GB
        time = 30.m
    }

    withLabel: process_medium {
        cpus = 2
        memory = 4.GB
        time = 2.h
    }

    withLabel: process_classifier {
        cpus = { params.classifier_cpus }
        memory = 16.GB
        time = 12.h
    }

    withLabel: process_high {
        cpus = 4
        memory = 8.GB
        time = 8.h
    }

    withLabel: process_high_memory {
        cpus = 8
        memory = 32.GB
        time = 12.h
    }
}

params.classifier_cpus = 8

// Profiles may replace this with an immutable object-storage prefix.
params.reference_cache_uri = null

// Launchers enable these with run-scoped output paths. Keeping the global
// observers disabled prevents duplicate writers when analyses run concurrently.
timeline.enabled = false
report.enabled = false
trace.enabled = false
dag.enabled = false
timeline.overwrite = true
report.overwrite = true
trace.overwrite = true
dag.overwrite = true
